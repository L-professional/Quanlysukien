# EventHub AI Frontend - PRODUCTION Environment
# ==============================================
# CAC BIEN NAY PHAI DUOC THIET LAP TREN VERCEL DASHBOARD:
# https://vercel.com/[username]/[project] -> Settings -> Environment Variables

# URL backend API thuc (deploy tren Railway/Render/VPS...)
VITE_API_URL=https://your-backend-api.railway.app/api/v1

# Tat demo login tren production
VITE_ENABLE_DEMO_LOGIN=false

# Google OAuth Client ID that (tao tai console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=your-real-google-client-id.apps.googleusercontent.com
