# EventHub AI Frontend Environment Configuration
# ================================================
# LOCAL DEV: localhost:8000
# VERCEL PRODUCTION: set VITE_API_URL via Vercel Dashboard → Environment Variables
# Nếu không set trên Vercel, API calls sẽ fallback sang chế độ demo (offline)
VITE_API_URL=http://localhost:8000/api/v1
VITE_ENABLE_DEMO_LOGIN=true
VITE_GOOGLE_CLIENT_ID=1029384756-demo-eventhub-ai.apps.googleusercontent.com
