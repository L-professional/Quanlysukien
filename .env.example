# Application Settings
PROJECT_NAME="EventHub AI"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL 15 with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventhub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventhub

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Resend Email Configuration (API Key from https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="EventHub AI <onboarding@resend.dev>"
EMAIL_REPLY_TO=support@eventhub.ai
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here
FRONTEND_URL=http://localhost:5173
