# Application Settings
PROJECT_NAME="EventHub AI"
API_V1_STR="/api/v1"
DEBUG=True
TZ=Asia/Ho_Chi_Minh
TIMEZONE=Asia/Ho_Chi_Minh

# Database Configuration (PostgreSQL 15 with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventhub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventhub

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Resend Email Configuration (API Key from https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="EventHub AI <onboarding@resend.dev>"
EMAIL_REPLY_TO=support@eventhub.ai
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# SMTP EMAIL CONFIGURATION (Task 83: Real Email Dispatch Service)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_16_chars
SMTP_FROM=EventAI Platform <your_email@gmail.com>

# ==============================================================================
# ULTRA-FAST DIRECT-TO-DEVICE OMNICHANNEL DISPATCH (Task 88: Email, SMS & Zalo)
# ==============================================================================
ESMS_API_KEY=your_esms_api_key_here
ESMS_SECRET_KEY=your_esms_secret_key_here
ESMS_BRANDNAME=EVENTHUB_AI
SPEEDSMS_ACCESS_TOKEN=your_speedsms_token_here
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Zalo Notification Service (ZNS)
ZALO_OA_ID=your_zalo_oa_id_here
ZALO_APP_ID=your_zalo_app_id_here
ZALO_SECRET_KEY=your_zalo_secret_key_here
ZALO_ACCESS_TOKEN=your_zalo_access_token_here
ZALO_REFRESH_TOKEN=your_zalo_refresh_token_here
ZALO_TEMPLATE_ID=your_approved_zns_template_id

