# Application Settings
PROJECT_NAME="EventHub AI"
API_V1_STR="/api/v1"
DEBUG=True
TZ=Asia/Ho_Chi_Minh
TIMEZONE=Asia/Ho_Chi_Minh

# Database Configuration (PostgreSQL 15 with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventhub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventhub

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ==============================================================================
# SMTP EMAIL CONFIGURATION (Task 83: Real Email Dispatch Service)
# ==============================================================================
# Máy chủ SMTP gửi thư mời, vé điện tử QR Code & bản tin truyền thông PR Studio.
# Nếu để trống, hệ thống sẽ trả về mã lỗi HTTP 500 kèm thông báo cấu hình chi tiết.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_16_chars
SMTP_FROM=EventAI Platform <your_email@gmail.com>

# 1. Gmail cá nhân / Google Workspace:
#    - Bật 2-Step Verification (Xác minh 2 bước) trong tài khoản Google.
#    - Vào https://myaccount.google.com/apppasswords tạo App Password (16 ký tự).
#    - Gán SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=email của bạn, SMTP_PASS=mật_khẩu_ứng_dụng.
# 2. Resend (khuyến nghị cho hệ thống lớn):
#    - SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=re_xxxxxxxx.
# 3. SendGrid:
#    - SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=SG.xxxxxxxx.

# ==============================================================================
# ULTRA-FAST DIRECT-TO-DEVICE OMNICHANNEL DISPATCH (Task 88: Email, SMS & Zalo)
# ==============================================================================
# 1. RESEND HTTP REST API (Tối ưu tốc độ gửi Email < 200ms không nghẽn cổng SMTP)
RESEND_API_KEY=re_123456789_abcdefghijk

# 2. VIETNAM SMS GATEWAY (eSMS.vn Brandname CSKH & OTP - Tốc độ tới máy 1-2 giây)
ESMS_API_KEY=your_esms_api_key_here
ESMS_SECRET_KEY=your_esms_secret_key_here
ESMS_BRANDNAME=EVENTHUB_AI

# SpeedSMS Backup Gateway (Tùy chọn)
SPEEDSMS_ACCESS_TOKEN=your_speedsms_token_here

# Twilio International SMS (Tùy chọn)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 3. ZALO NOTIFICATION SERVICE (ZNS - Bắn thẳng Notification vào Zalo cá nhân < 1 giây)
ZALO_OA_ID=your_zalo_oa_id_here
ZALO_APP_ID=your_zalo_app_id_here
ZALO_SECRET_KEY=your_zalo_secret_key_here
ZALO_ACCESS_TOKEN=your_zalo_access_token_here
ZALO_REFRESH_TOKEN=your_zalo_refresh_token_here
ZALO_TEMPLATE_ID=your_approved_zns_template_id

